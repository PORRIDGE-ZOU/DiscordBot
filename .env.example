# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
#
# DISCORD_TOKEN — your bot's secret token from the Developer Portal
#   (Application -> Bot -> Reset Token -> Copy). This is the bot's password and
#   identity. If it ever leaks, regenerate it in the portal.
DISCORD_TOKEN=

# DISCORD_GUILD_ID — OPTIONAL. Your server's ID. If set, slash commands register
#   to just this server and appear INSTANTLY. If left blank, commands register
#   globally and can take up to ~1 hour to show up. Useful during development.
#   To get it: enable Developer Mode (Discord -> Settings -> Advanced -> Developer
#   Mode), then right-click your server icon -> Copy Server ID.
DISCORD_GUILD_ID=

# NOTION_TOKEN — Internal Integration Secret from a Notion connection
#   (notion.so/my-integrations -> your connection -> Configuration -> Secrets).
#   Starts with `ntn_`. The connection only sees pages/databases explicitly shared
#   with it (page -> ••• -> Connections).
NOTION_TOKEN=

# NOTION_TASKS_DB_ID — the task database's ID. Open the database as a full page,
#   Copy link, and take the 32-char hex chunk before the `?v=`. Example URL:
#   notion.so/workspace/<THIS_32_CHAR_ID>?v=... The database must be shared with
#   the connection (same Connections step as above).
NOTION_TASKS_DB_ID=

# OPENAI_API_KEY — used ONLY to parse the #time-off channel's plain-English posts
#   into dates. Get one at platform.openai.com/api-keys. Like every other secret
#   here: real value in .env, never in code, never committed.
OPENAI_API_KEY=

# OPENAI_MODEL — OPTIONAL. Which model parses those messages. Defaults to gpt-4o.
#   Set it if you want a different one; a bad id fails loudly on the first call.
OPENAI_MODEL=

# TIMEOFF_CHANNEL_ID — the #time-off channel's ID, used by /time-off-recently and
#   /time-off-this-month. An ID, not a name — the emoji in the channel name makes
#   lookup-by-name fragile. To get it: enable Developer Mode (Discord -> Settings
#   -> Advanced), then right-click the channel -> Copy Channel ID.
TIMEOFF_CHANNEL_ID=
