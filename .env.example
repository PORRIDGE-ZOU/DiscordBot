# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
#
# DISCORD_TOKEN — your bot's secret token from the Developer Portal
#   (Application -> Bot -> Reset Token -> Copy). This is the bot's password and
#   identity. If it ever leaks, regenerate it in the portal.
DISCORD_TOKEN=

# DISCORD_GUILD_ID — OPTIONAL. Your server's ID. If set, slash commands register
#   to just this server and appear INSTANTLY. If left blank, commands register
#   globally and can take up to ~1 hour to show up. Useful during development.
#   To get it: enable Developer Mode (Discord -> Settings -> Advanced -> Developer
#   Mode), then right-click your server icon -> Copy Server ID.
DISCORD_GUILD_ID=
