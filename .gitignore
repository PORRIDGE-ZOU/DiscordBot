# Secrets — the bot token lives here. NEVER commit this.
.env

# Python virtual environment
venv/
.venv/

# Python caches
__pycache__/
*.pyc

# Meeting recordings + transcripts (added now so they never get committed later)
recordings/
transcripts/

# Scheduler state — live reminders. NEVER commit, and NEVER let a deploy rsync
# overwrite the server's copy (that would wipe scheduled reminders).
jobs.sqlite

# Local bot state — Discord<->Notion associations + the active sprint. Live server
# state, same rules as jobs.sqlite: never commit, never deploy over it.
botstate.db

